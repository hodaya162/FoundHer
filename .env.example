# Required before a public production deployment. Use the verified HTTPS origin only.
NEXT_PUBLIC_SITE_URL=

# Disabled by default. Initial approved catalog snapshots are served without repeated remote pulls.
# Enable only after recurring automated access has been confirmed with both catalog owners.
CATALOG_REMOTE_REFRESH_ENABLED=false

# Catalog moderation (configure Preview and Production with different Supabase projects)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this value with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SECRET_KEY=
